#. Plugin Name of the plugin
#: plogins-swatch.php
msgid "Swatch - Variation Swatches for WooCommerce"
msgstr "Swatch - próbki wariantów dla WooCommerce"

#. Plugin URI of the plugin
#: plogins-swatch.php
msgid "https://plogins.com/plogins-swatch/"
msgstr "https://plogins.com/plogins-swatch/"

#. Description of the plugin
#: plogins-swatch.php
msgid "Replace variation dropdowns with accessible colour and label swatches."
msgstr ""
"Zastąp listy rozwijane wariantów dostępnymi próbnikami kolorów i etykiet."

#. Author of the plugin
#: plogins-swatch.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-swatch.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-swatch.php:48
msgid "Plogins Swatch for WooCommerce requires WooCommerce to be active."
msgstr "Plogins Swatch for WooCommerce wymaga aktywnej wtyczki WooCommerce."

